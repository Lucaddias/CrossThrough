-        attributes = GetFileAttributesW(dll_path);
-    }
-
-    if (attributes == INVALID_FILE_ATTRIBUTES)
-    {
-        lstrcpyW(dll_path, path);
-        lstrcatW(dll_path, libmono2_dll);
-        attributes = GetFileAttributesW(dll_path);
