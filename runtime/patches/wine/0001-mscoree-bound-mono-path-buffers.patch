mscoree: não estoura buffers MAX_PATH com o Mono num caminho longo.

find_mono_dll() e get_support_msi() concatenam o caminho do Mono com sufixos
em buffers WCHAR[MAX_PATH] sem conferir o tamanho. Com o runtime (e portanto
WINEDATADIR/mono) num diretório longo, o wineboot --init corrompe a pilha de
install_wine_mono() e o rundll32 do DefaultInstall cai em kernelbase
copy_file() lendo um ponteiro feito de texto ("ort." de "support.msi").

Um caminho que não cabe passa a contar como "não encontrado" (com WARN), e o
caller segue para a próxima opção. Os callers continuam passando buffers de
MAX_PATH: find_mono_dll() só tem sucesso para caminhos que cabem neles.

--- a/dlls/mscoree/metahost.c
+++ b/dlls/mscoree/metahost.c
@@ -717,31 +717,29 @@
 static const WCHAR libmono2_arch_dll[] = {'\\','b','i','n','\\','l','i','b','m','o','n','o','-','2','.','0','.','d','l','l',0};
 #endif
 
+/* dll_path holds MAX_PATH characters; a path that would not fit is treated
+ * as not found instead of overflowing it. */
+static BOOL mono_dll_exists(LPCWSTR path, LPCWSTR suffix, LPWSTR dll_path)
+{
+    if (lstrlenW(path) + lstrlenW(suffix) >= MAX_PATH)
+    {
+        WARN("path too long: %s%s\n", debugstr_w(path), debugstr_w(suffix));
+        return FALSE;
+    }
+    lstrcpyW(dll_path, path);
+    lstrcatW(dll_path, suffix);
+    return GetFileAttributesW(dll_path) != INVALID_FILE_ATTRIBUTES;
+}
+
